# Discord bot token (required)
DISCORD_TOKEN=

# Optional AI command (!ask). Leave the key empty to disable it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Discord user ID of the bot owner (recommended for owner-only controls)
BOT_OWNER_ID=

# Optional ticket system
TICKET_ENABLED=false
TICKET_CATEGORY_ID=
TICKET_STAFF_CHANNEL_ID=
TICKET_STAFF_ROLE_ID=
TICKET_STATE_PATH=./tickets_state.json
TICKET_ARCHIVE_CHANNEL_ID=

# Optional persistent server language database
GUILD_LANGUAGE_DB=./guild_languages.sqlite3
